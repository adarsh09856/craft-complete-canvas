# =========================================================================
# GOLDEN TAKIN HOLIDAYS — ENVIRONMENT CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# OPTION 1: aaPanel Self-Hosted Supabase Stack (RECOMMENDED)
# -------------------------------------------------------------------------
# If you run self-hosted Supabase on your aaPanel VPS (via Docker):
VITE_SUPABASE_URL="http://YOUR_AAPANEL_SERVER_IP:8000"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"
SUPABASE_URL="http://YOUR_AAPANEL_SERVER_IP:8000"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-admin-key-here"

# -------------------------------------------------------------------------
# OPTION 2: aaPanel Native PostgreSQL Manager (Direct Database Connection)
# -------------------------------------------------------------------------
# Standard PostgreSQL URI from aaPanel PostgreSQL Manager:
DATABASE_URL="postgresql://takin_admin:your_secure_password@YOUR_AAPANEL_SERVER_IP:5432/goldentakin_travel"
POSTGRES_HOST="YOUR_AAPANEL_SERVER_IP"
POSTGRES_PORT="5432"
POSTGRES_USER="takin_admin"
POSTGRES_PASSWORD="your_secure_password"
POSTGRES_DB="goldentakin_travel"

# -------------------------------------------------------------------------
# AI Travel Concierge
# -------------------------------------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# -------------------------------------------------------------------------
# Application URLs & Payments
# -------------------------------------------------------------------------
APP_URL="https://goldentakinholidays.bt"
PORT=3000
